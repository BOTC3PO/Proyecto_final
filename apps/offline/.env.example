# Configuración de la compilación de la app sin conexión. Copiar a .env.local (no se sube al repositorio).
# API de la plataforma, para activar cuentas (por ejemplo https://192.168.0.28/api). Vacía = solo usuarios locales.
VITE_API_REMOTA=
# Clave pública Ed25519 de los permisos (la muestra api/scripts/generar_clave_permiso.ts).
VITE_OFFLINE_CLAVE_PUBLICA=
# true cuando la plataforma deje de estar en producción: los permisos no vencen y no se llama al servidor.
VITE_MODO_AUTONOMO=false
# false para no permitir usuarios locales.
VITE_USUARIOS_LOCALES=true
