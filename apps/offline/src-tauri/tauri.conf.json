{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Virtual Book",
  "version": "0.1.0",
  "identifier": "ar.virtualbook.offline",
  "build": {
    "frontendDist": "../dist-web"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Virtual Book",
        "width": 1100,
        "height": 760
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "minSdkVersion": 26
    },
    "category": "Education",
    "shortDescription": "Módulos, prácticas y evaluaciones de Virtual Book sin internet",
    "longDescription": "La app sin conexión de Virtual Book: módulos, prácticas y evaluaciones en el dispositivo, sin internet. Los datos quedan en el dispositivo y se sincronizan con la plataforma cuando hay red.",
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller",
        "silent": true
      },
      "nsis": {
        "installMode": "both",
        "languages": [
          "Spanish"
        ],
        "startMenuFolder": "Virtual Book"
      }
    },
    "linux": {
      "deb": {
        "section": "education"
      }
    }
  }
}
