# Copiar a ~/.config/virtualbook/docker.env (chmod 600) y completar. NO va al repositorio.

# Nombre del proyecto de compose (cambiarlo para levantar una copia de prueba en paralelo).
VB_PROYECTO=virtualbook
# Etiqueta de la imagen de la API (el despliegue usa el commit).
VB_VERSION=local
VB_REPLICAS=2
# Rango de puertos en 127.0.0.1 para las réplicas de la API (nginx reparte entre 5050-5053).
VB_PUERTOS=5050-5053

# Rutas del servidor
VB_API_ENV=/home/javier/proyectos/monolitico/app/api/.env
VB_DICCIONARIO=/home/javier/proyectos/monolitico/datos/diccionario
VB_MEDIA=/home/javier/proyectos/monolitico/datos/media
VB_RESPALDOS=/home/javier/proyectos/monolitico/datos/backups

# Base de datos del contenedor (usuario y clave nuevos, solo para el contenedor)
PG_USUARIO=virtualbook
PG_CLAVE=
PG_SHARED_BUFFERS=512MB

# Límites (ver tareas_pendientes/PRESUPUESTO-recursos-2026-11-10.md)
PG_MEMORIA=2g
PG_CPUS=4
API_MEMORIA=1g
API_CPUS=2
