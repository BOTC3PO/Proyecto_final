  moneda              String          @default("ARS")
  expansiones         Int             @default(0)
  canceladaAt         String?         @map("cancelada_at")
  canceladaBy         String?         @map("cancelada_by")
  reembolsoSolicitado Int             @default(0) @map("reembolso_solicitado")
