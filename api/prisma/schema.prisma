// PLAN-R Parte 5 — token de push (Expo) de la app móvil. Un usuario
// puede tener el token registrado en más de un dispositivo (@@unique
// es sobre el token en sí, no sobre userId — reinstalar/reloguearse
// en otro teléfono agrega una fila nueva, no pisa la anterior). El
// envío real (expo-server-sdk, disparado desde mensajería/tareas/
// cobros) queda para otra sesión — este modelo sólo guarda dónde
// mandar el push cuando exista ese código.
model PushToken {
  id        String  @id
  userId    String  @map("user_id")
  token     String  @unique
  platform  String? // "ios" | "android"
  createdAt String  @map("created_at")
  updatedAt String  @map("updated_at")

  @@map("push_tokens")
  @@index([userId])
}

// F8 — refresh token rotation. Cada refresh JWT firmado lleva un
// `jti` único; el servidor persiste una fila por `jti` vivo. En
// /api/auth/refresh se busca por `jti`, se marca `revoked=true` y
// se emite un refresh NUEVO con `jti` nuevo y `replacedBy` apuntando
// al viejo. Si el mismo `jti` se presenta DOS veces → reuse detection:
// se asume compromiso y se revocan TODAS las filas de la misma
// `familyId` (signals theft, fuerza logout del usuario real). El
// `familyId` agrupa todos los refresh tokens emitidos desde una misma
// sesión de login para que un solo evento de reuse los invalide a
// todos en lugar de sólo al presentado.
model RefreshToken {
  id          String   @id @default(cuid())
  jti         String   @unique
  userId      String   @map("user_id")
  familyId    String   @map("family_id")
  revoked     Boolean  @default(false)
  replacedBy  String?  @map("replaced_by")
  expiresAt   DateTime @map("expires_at")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("refresh_tokens")
  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
}

/// K10b — chat de soporte grupal. Un hilo por persona que pide ayuda. Participan: todos los ADMIN, el
/// directivo principal de su escuela, quien lo abrió y los padres con vínculo aprobado con esa persona (así un
/// menor nunca queda a solas con alguien ajeno a la escuela). Los participantes se calculan al leer.
model HiloSoporte {
  id            String           @id
  solicitanteId String           @unique @map("solicitante_id")
  escuelaId     String?          @map("escuela_id")
  ultimoMsg     String?          @map("ultimo_msg")
  ultimoAt      String?          @map("ultimo_at")
  createdAt     String           @map("created_at")
  mensajes      MensajeSoporte[]
  @@index([escuelaId])
  @@map("hilos_soporte")
}

model MensajeSoporte {
  id        String      @id
  hiloId    String      @map("hilo_id")
  senderId  String      @map("sender_id")
  body      String
  createdAt String      @map("created_at")
  hilo      HiloSoporte @relation(fields: [hiloId], references: [id])
  @@index([hiloId, createdAt])
  @@map("mensajes_soporte")
}

model SoporteLectura {
  hiloId   String @map("hilo_id")
  usuarioId String @map("usuario_id")
  leidoAt  String @map("leido_at")
  @@id([hiloId, usuarioId])
  @@map("soporte_lecturas")
}
