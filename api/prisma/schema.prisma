generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Escuela {
  id                 String   @id
  name               String
  code               String?  @unique
  address            String?
  subscriptionStatus String?  @map("subscription_status")
  plan               String?
  isDeleted          Boolean  @default(false) @map("is_deleted")
  createdAt          String   @map("created_at")
  updatedAt          String?  @map("updated_at")
  // Fase 5.1 — modelo de comisión (demostrable; el split real con OAuth de MP
  // queda como roadmap v2). Sistema autogestionado: la escuela cobra con su
  // propia cuenta conectada (EscuelaPasarela), VB nunca maneja los fondos —
  // sólo retiene esta comisión y liquida el resto. comisionPct = tarifa
  // doméstica (MercadoPago/Argentina, 5-7%); comisionPctIntl = tarifa
  // internacional (Cryptomus, 1-2%).
  comisionPct        Float?   @map("comision_pct")
  comisionPctIntl    Float?   @map("comision_pct_intl")
  // PLAN-B Fase 6 (ítem 34) — saldo de bienvenida (economía interna del
  // juego, no dinero real) que recibe cada alumno nuevo. Configurable por
  // escuela; default 50 backfileado en la migración para las existentes.
  saldoInicialAlumno Float    @default(50) @map("saldo_inicial_alumno")
  // PLAN-C §4 (ítem 29) — personalización por escuela. JSON serializado:
  // { logoUrl?, iconoUrl?, colorPrimario?, colorSecundario? }. Null =
  // sin personalizar, usa el branding default de la plataforma.
  branding           String?
  /// PLAN-multirol / verificación — "pendiente" | "verificada" | "rechazada".
  /// Gatea TODO lo que mueve plata: conectar pasarela, publicar cobros y
  /// confirmar pagos. Una escuela sin verificar puede usar el resto de la
  /// plataforma (aulas, módulos, evaluaciones, boletines) — lo que no puede
  /// es cobrarle a las familias con la plataforma de por medio.
  estadoVerificacion String   @default("pendiente") @map("estado_verificacion")
  /// Quien registró la escuela. Es el DIRECTIVO PRINCIPAL: el único que
  /// puede conectar la pasarela de cobro. Otros directivos gestionan el
  /// resto. Null en las escuelas creadas por un admin antes de este flujo.
  directivoPrincipalId String? @map("directivo_principal_id")
  /// JSON con los datos declarados en el alta (razón social, CUIT,
  /// domicilio, contacto, CUE si aplica). Es lo que el admin mira para
  /// verificar; no se expone fuera del panel de admin ni del propio directivo.
  datosVerificacion  String?  @map("datos_verificacion")
  motivoRechazo      String?  @map("motivo_rechazo")
  /// Cryptomus habilitado para ESTA escuela. Apagado por default y sólo lo
  /// enciende el ADMIN de plataforma, escuela por escuela.
  ///
  /// Por qué no es como MercadoPago: Cryptomus liquida con comisión pero
  /// TODO adentro de la cuenta de VB, y el pago a la escuela es manual. O
  /// sea que en ese camino VB custodia fondos de terceros, que es
  /// justamente lo que el modelo evita. No se puede quitar porque hoy no
  /// hay otra opción para pagos del exterior, así que se acota: se elige
  /// con qué escuelas se asume ese riesgo en vez de asumirlo con todas.
  cryptomusHabilitado Boolean @default(false) @map("cryptomus_habilitado")
  /// Interés por mora de las cuotas. Lo configura la dirección de la escuela; apagado por defecto.
  /// La tasa es simple y se prorratea por día de atraso, después de los días de gracia.
  moraActiva         Boolean  @default(false) @map("mora_activa")
  /// Porcentaje por período (ver MORA_TASA_MAX en lib/mora.ts).
  moraTasa           Float    @default(2) @map("mora_tasa")
  /// "mensual" | "anual"
  moraPeriodo        String   @default("mensual") @map("mora_periodo")
  moraDiasGracia     Int      @default(0) @map("mora_dias_gracia")
  /// Comisión de VB sobre cooperadoras y aportes solidarios: 0 a 1 %, la elige la institución.
  comisionPctAportes Float    @default(0) @map("comision_pct_aportes")
  /// Monto máximo que la ley de la jurisdicción permite pedir como aporte voluntario. Null = sin cargar.
  topeAporteLegal    Float?   @map("tope_aporte_legal")
  usuarios           Usuario[]
  membresias         Membresia[]
  clases             Clase[]
  transacciones      TransaccionEscuela[]
  liquidaciones      LiquidacionEscuela[]
  cobros             CobroEscuela[]
  pasarelas          EscuelaPasarela[]
  @@map("escuelas")
}

// PLAN-B §Fase 2 — núcleo de cobros escuela→familias, independiente de la
// pasarela (la conexión con Mercado Pago/Stripe/Cryptomus es Fase 3).
//
// `CobroEscuela` es la "orden de cobro" que crea el directivo/admin (ej.
// "Cuota julio 2026"). Al publicarla se generan las `CuotaAlumno` — una
// instancia por alumno destinatario, con su propio estado y `montoFinal`
// (permite becas/descuentos sin tocar el cobro original).
model CobroEscuela {
  id            String        @id
  escuelaId     String        @map("escuela_id")
  concepto      String
  descripcion   String?
  montoUnitario Float         @map("monto_unitario")
  moneda        String        @default("ARS")
  vencimiento   String?
  // cuota | cooperadora | aporte_solidario. Las dos últimas son voluntarias: sin mora y con otra comisión.
  tipo          String        @default("cuota")
  // borrador | publicado | cerrado
  estado        String        @default("borrador")
  createdBy     String        @map("created_by")
  createdAt     String        @map("created_at")
  updatedAt     String        @map("updated_at")
  escuela       Escuela       @relation(fields: [escuelaId], references: [id])
  cuotas        CuotaAlumno[]
  @@index([escuelaId])
  @@map("cobros_escuela")
}

// Instancia de un `CobroEscuela` para UN alumno. `pagadorId` es quién
// efectivamente paga (típicamente el padre/madre vinculado; puede ser el
// propio alumno si es adulto). `montoFinal` puede diferir de
// `cobro.montoUnitario` (becas/descuentos) sin tocar el cobro original.
model CuotaAlumno {
  id         String       @id
  cobroId    String       @map("cobro_id")
  alumnoId   String       @map("alumno_id")
  pagadorId  String?      @map("pagador_id")
  // pendiente | en_proceso | pagada | vencida | anulada
  estado     String       @default("pendiente")
  montoFinal Float        @map("monto_final")
  pagoId     String?      @map("pago_id")
  createdAt  String       @map("created_at")
  updatedAt  String       @map("updated_at")
  cobro      CobroEscuela @relation(fields: [cobroId], references: [id])
  pago       Pago?        @relation(fields: [pagoId], references: [id])
  @@unique([cobroId, alumnoId])
  @@index([alumnoId])
  @@index([pagadorId])
  @@map("cuotas_alumno")
}

// La persistencia que `payments.ts` reclama (ver comentario histórico en
// `api/src/lib/payments/index.ts`) — acá para el dominio cobros
// escuela→familias. `provider` es "manual" mientras la escuela no tenga
// una pasarela conectada (Fase 3); ahí queda todo el flujo operable sin
// depender de credenciales externas. `raw` guarda el payload del webhook
// del provider tal cual, para auditoría/debug.
model Pago {
  id               String        @id
  provider         String
  providerRef      String?       @map("provider_ref")
  // pendiente | en_proceso | pagada | fallida | anulada
  estado           String        @default("pendiente")
  montoBruto       Float         @map("monto_bruto")
  // Desglose cuando hay mora: montoBruto = montoOriginal + interesMora. Null en pagos sin mora.
  montoOriginal    Float?        @map("monto_original")
  interesMora      Float?        @map("interes_mora")
  comisionVB       Float?        @map("comision_vb")
  montoNetoEscuela Float?        @map("monto_neto_escuela")
  raw              String?
  createdAt        String        @map("created_at")
  updatedAt        String        @map("updated_at")
  cuotas           CuotaAlumno[]
  // Idempotencia de webhooks: nunca crear dos Pago para el mismo
  // (provider, providerRef) aunque el provider reintente la notificación.
  @@unique([provider, providerRef])
  @@map("pagos")
}

// PLAN-B Fase 3 — conexión de una escuela con un provider de pago.
// `cuentaConectadaId` es la cuenta DE LA ESCUELA en el provider (ej. el
// `collector_id`/access_token de vendedor de Mercado Pago) — NUNCA la
// cuenta de VB. `credencialesCifradas` guarda el token OAuth/API key
// que haga falta, cifrado (nunca en texto plano ni en logs de webhook).
// Cryptomus no tiene split nativo — para ese provider esta fila sólo
// guarda la API key de la escuela para poder facturar/verificar en su
// nombre; el dinero pasa por VB igual (modo v1, liquidación manual).
model EscuelaPasarela {
  id                   String  @id
  escuelaId            String  @map("escuela_id")
  // "mercadopago" | "cryptomus"
  provider             String
  cuentaConectadaId    String? @map("cuenta_conectada_id")
  credencialesCifradas String? @map("credenciales_cifradas")
  activa               Boolean @default(true)
  /// "escuela" | "cooperadora": de quién es la cuenta. Los cobros de cooperadora van a la cuenta de la
  /// cooperadora (asociación con CUIT propio), nunca a la de la escuela.
  titular              String  @default("escuela")
  createdAt            String  @map("created_at")
  updatedAt            String  @map("updated_at")
  escuela              Escuela @relation(fields: [escuelaId], references: [id])
  @@unique([escuelaId, provider, titular])
  @@map("escuelas_pasarelas")
}

/// Fase 5.1 — registro contable de cada cobro de una escuela autogestionada.
model TransaccionEscuela {
  id          String   @id
  escuelaId   String   @map("escuela_id")
  montoTotal  Float    @map("monto_total")
  comisionVB  Float    @map("comision_vb")
  montoNeto   Float    @map("monto_neto")
  estado      String   @default("registrada")
  // PLAN-B Fase 4 — de qué pasarela vino este cobro (mercadopago|cryptomus|
  // manual). Default "mercadopago" para las filas históricas (todo lo
  // pre-Fase-3 era del SaaS de suscripción, siempre MP).
  provider    String   @default("mercadopago")
  /// "escuela" | "cooperadora": a quién le corresponde el neto.
  titular     String   @default("escuela")
  mpPaymentId String?  @map("mp_payment_id")
  createdAt   String   @map("created_at")
  escuela     Escuela  @relation(fields: [escuelaId], references: [id])
  @@index([escuelaId])
  @@map("transacciones_escuela")
}

/// Fase 5.1 — liquidación periódica del saldo neto hacia la escuela.
model LiquidacionEscuela {
  id             String   @id
  escuelaId      String   @map("escuela_id")
  periodo        String
  montoLiquidado Float    @map("monto_liquidado")
  cantTransacc   Int      @map("cant_transacc")
  metodo         String
  // PLAN-B Fase 4 — "manual" (VB retuvo el dinero — Cryptomus siempre,
  // o modo centralizado — y liquida por fuera) vs "split_nativo"
  // (Stripe/MP ya depositaron el neto directo a la escuela; esta fila
  // es sólo INFORMATIVA/auto-conciliada, no dispara una transferencia).
  tipo           String   @default("manual")
  createdAt      String   @map("created_at")
  escuela        Escuela  @relation(fields: [escuelaId], references: [id])
  @@index([escuelaId])
  @@map("liquidaciones_escuela")
}

model Usuario {
  id                    String   @id
  username              String   @unique
  email                 String   @unique
  fullName              String   @map("full_name")
  /// Admin principal de la plataforma: el único que puede cambiar roles
  /// (y por lo tanto crear otros ADMIN). Antes esto se intentaba deducir de
  /// un campo `createdBy` que NUNCA existió en la tabla, con lo cual el
  /// chequeo daba true para todos: cualquier ADMIN podía promover a ADMIN.
  esAdminPrincipal      Boolean  @default(false) @map("es_admin_principal")
  /// PLAN-roles-v3 B2 — verificación del PERFIL PÚBLICO.
  ///
  /// Distinta de la verificación de escuela: acá no se valida una
  /// institución sino a una persona que dice ser profesora o directiva
  /// "fuera del registro" — sin una escuela que responda por ella. Sin
  /// verificar, ese rol no se muestra en su perfil público.
  /// "no_solicitada" | "pendiente" | "verificada" | "rechazada"
  verificacionPublica   String   @default("no_solicitada") @map("verificacion_publica")
  datosVerificacion     String?  @map("datos_verificacion")
  motivoRechazoPublico  String?  @map("motivo_rechazo_publico")
  roles                 String[] @default([])
  escuelaId             String?  @map("escuela_id")
  passwordHash          String?  @map("password_hash")
  birthdate             String?
  guestOnboardingStatus String?  @map("guest_onboarding_status")
  privacyConsent        Boolean? @map("privacy_consent")
  termsAccepted         Boolean? @map("terms_accepted")
  consentedAt           String?  @map("consented_at")
  isDeleted             Boolean  @default(false) @map("is_deleted")
  passwordResetRequired Boolean  @default(false) @map("password_reset_required")
  isBanned              Boolean  @default(false) @map("is_banned")
  bannedAt              String?  @map("banned_at")
  bannedUntil           String?  @map("banned_until")
  warningCount          Int      @default(0) @map("warning_count")
  /// B13 — verificación en dos pasos (TOTP). El secreto va cifrado (lib/totp.ts); `totpActivo` recién cuando
  /// la persona confirmó un código. `totpUltimoPaso` impide reusar un código. Los de recuperación, hasheados.
  totpSecreto           String?  @map("totp_secreto")
  totpActivo            Boolean  @default(false) @map("totp_activo")
  totpUltimoPaso        Int?     @map("totp_ultimo_paso")
  totpRecuperacion      String?  @map("totp_recuperacion")
  /// B9 — cuándo confirmó su correo. Null = registro propio sin confirmar (no puede iniciar sesión mientras
  /// la verificación esté activa). Las cuentas creadas por la escuela o el administrador nacen confirmadas.
  emailVerificadoAt     String?  @map("email_verificado_at")
  createdAt             String   @map("created_at")
  updatedAt             String   @map("updated_at")
  escuela               Escuela? @relation(fields: [escuelaId], references: [id])
  membresias            Membresia[]
  @@map("usuarios")
}

/// PLAN-multirol — fuente de verdad de "a qué escuelas pertenece esta
/// persona y con qué rol". El rol está DENTRO de la PK: la misma persona
/// puede ser profesor y padre en la misma escuela sin duplicar cuenta (era
/// justamente lo que forzaba las cuentas espejo). `fechaAlta` + `estado`
/// resuelven el rol principal: el más antiguo que siga `activa`.
model Membresia {
  usuarioId  String   @map("usuario_id")
  escuelaId  String   @map("escuela_id")
  rol        String
  estado     String
  /// Delegación de cobros. Sólo el directivo principal (el que registró la
  /// escuela) la otorga. Conectar la pasarela sigue siendo exclusivo del
  /// principal: esto habilita EMITIR y CONFIRMAR, no decidir a qué cuenta
  /// va la plata.
  puedeCobrar Boolean @default(false) @map("puede_cobrar")
  fechaAlta  String   @map("fecha_alta")
  fechaBaja  String?  @map("fecha_baja")
  createdAt  String?  @map("created_at")
  updatedAt  String?  @map("updated_at")
  usuario    Usuario  @relation(fields: [usuarioId], references: [id])
  escuela    Escuela  @relation(fields: [escuelaId], references: [id])
  @@id([usuarioId, escuelaId, rol])
  @@index([usuarioId])
  @@map("membresias")
}


/// PLAN-roles-v3 A3 — pedir e invitar son la MISMA fila mirada desde los
/// dos lados: cambia quién la inicia y, por lo tanto, quién la aprueba.
/// Un alumno que pide ser profesor la inicia él y la aprueba el directivo;
/// un directivo que invita a alguien la inicia él y la acepta el invitado.
model InvitacionRol {
  id           String  @id
  escuelaId    String  @map("escuela_id")
  /// A quién le toca el rol.
  destinatario String
  /// Rol de escuela pedido/ofrecido (MEMBERSHIP_ROLES).
  rol          String
  /// Quién inició. Si coincide con `destinatario` es un PEDIDO; si no, una INVITACIÓN.
  iniciadoPor  String  @map("iniciado_por")
  /// pendiente | aceptada | rechazada
  estado       String  @default("pendiente")
  resueltoPor  String? @map("resuelto_por")
  motivo       String?
  createdAt    String  @map("created_at")
  updatedAt    String  @map("updated_at")
  @@index([destinatario, estado])
  @@index([escuelaId, estado])
  @@map("invitaciones_rol")
}

model Clase {
  id              String   @id
  escuelaId       String   @map("escuela_id")
  name            String
  grade           String
  /// L1 — descripción, categoría y tipo de acceso: el formulario los mandaba pero no había dónde guardarlos.
  description     String?
  category        String?
  /// "publica" | "privada". Por defecto privada: un aula escolar no queda pública si nadie lo eligió.
  accessType      String   @default("privada") @map("access_type")
  code            String?
  classCode       String?  @map("class_code")
  // Tarea 14 — ajuste del aula: permite que los alumnos comenten las
  // publicaciones del feed (POST /api/aulas/:id/publicaciones/:pubId/comentarios
  // ya existía en el back pero sin ningún gate de aula ni UI). Default true
  // preserva el comportamiento previo (el endpoint siempre aceptaba).
  allowComments   Boolean  @default(true) @map("allow_comments")
  isDeleted       Boolean  @default(false) @map("is_deleted")
  status          String   @default("ACTIVE")
  createdBy       String?  @map("created_by")
  teacherId       String?  @map("teacher_id")
  teacherOfRecord String?  @map("teacher_of_record")
  deletedAt       String?  @map("deleted_at")
  deletedBy       String?  @map("deleted_by")
  createdAt       String   @map("created_at")
  updatedAt       String?  @map("updated_at")
  escuela         Escuela  @relation(fields: [escuelaId], references: [id])
  miembros        ClaseMiembro[]
  modulos         ClaseModulo[]
  publicaciones   ClasePublicacion[]
  asistencias     Asistencia[]
  periodos        ClasePeriodo[]
  @@map("clases")
}

model ClaseMiembro {
  claseId    String @map("clase_id")
  usuarioId  String @map("usuario_id")
  rolEnClase String @map("rol_en_clase")
  /// PLAN-multirol Fase 3 — inscripción de alguien que NO es alumno real
  /// del aula: staff (o un padre) entrando a vivir el contenido como
  /// alumno. Reemplaza a la cuenta espejo: antes esto se distinguía por
  /// `Usuario.tipoCuenta = "ESPEJO_ALUMNO"`, o sea por CUENTA; ahora se
  /// distingue por INSCRIPCIÓN, que es donde realmente importa (rosters,
  /// asistencia, estadísticas y conteo de cobros).
  esPrueba   Boolean @default(false) @map("es_prueba")
  clase      Clase  @relation(fields: [claseId], references: [id])
  @@id([claseId, usuarioId, rolEnClase])
  @@map("clase_miembros")
}

// PLAN-A §3 — persistencia real de asistencia (antes `GET
// /api/profesor/asistencia` devolvía [] hardcodeado: "la colección
// 'asistencias' no existe aún en Prisma"). `estado` es
// presente|ausente|tarde|justificado (validado en la capa de schema
// zod, no en la DB, mismo patrón que `Clase.status`).
model Asistencia {
  id            String  @id
  claseId       String  @map("clase_id")
  alumnoId      String  @map("alumno_id")
  fecha         String
  estado        String
  registradoPor String  @map("registrado_por")
  notas         String?
  createdAt     String  @map("created_at")
  updatedAt     String  @map("updated_at")
  clase         Clase   @relation(fields: [claseId], references: [id])
  @@unique([claseId, alumnoId, fecha])
  @@map("asistencias")
}

// PLAN-V §1 — períodos académicos declarados EN el aula (nunca un motor
// de calendario global): lista libre y ordenada de `{ nombre, desde,
// hasta }` por docente. "2 semestres + verano" son 3 filas; anual es 1.
// `desde`/`hasta` son fechas ISO (yyyy-mm-dd) como string, mismo patrón
// que `Asistencia.fecha` — la comparación lexicográfica alcanza.
model ClasePeriodo {
  id        String @id
  claseId   String @map("clase_id")
  nombre    String
  desde     String
  hasta     String
  orden     Int
  createdAt String @map("created_at")
  updatedAt String @map("updated_at")
  clase     Clase  @relation(fields: [claseId], references: [id])
  @@index([claseId])
  @@map("clase_periodos")
}

model ClaseModulo {
  claseId    String  @map("clase_id")
  moduloId   String  @map("modulo_id")
  assignedAt String? @map("assigned_at")
  required   Boolean @default(false)
  clase      Clase   @relation(fields: [claseId], references: [id])
  @@id([claseId, moduloId])
  @@map("clase_modulos")
}

// PLAN-X §7 — invitación individual a un módulo descatalogado. Espejo
// deliberado de `ClaseModulo` (misma forma de join-table liviana, sin
// relación Prisma a `Modulo`/`Usuario` — mismo criterio que esa tabla).
// Un alumno invitado ve el módulo en los listados aunque esté
// descatalogado; el docente dueño (o quien lo invitó) lo da de baja
// borrando la fila.
model ModuloInvitacion {
  moduloId   String  @map("modulo_id")
  usuarioId  String  @map("usuario_id")
  invitedBy  String? @map("invited_by")
  createdAt  String  @default("") @map("created_at")
  @@id([moduloId, usuarioId])
  @@map("modulo_invitaciones")
}

model ClasePublicacion {
  id          String @id
  claseId     String @map("clase_id")
  authorId    String @map("author_id")
  title       String
  body        String
  linksJson   String? @map("links_json")
  isPinned    Boolean @default(false) @map("is_pinned")
  publishedAt String  @map("published_at")
  clase       Clase   @relation(fields: [claseId], references: [id])
  @@map("clase_publicaciones")
}

model Conversacion {
  id                 String @id
  studentId          String @map("student_id")
  parentId           String @map("parent_id")
  classId            String @map("class_id")
  lastMessageFrom    String? @map("last_message_from")
  lastMessagePreview String? @map("last_message_preview")
  unreadForAdmin     Boolean @default(false) @map("unread_for_admin")
  createdAt          String  @map("created_at")
  updatedAt          String? @map("updated_at")
  mensajes           MensajeItem[]
  @@map("conversaciones")
}

model MensajeItem {
  id             String       @id
  conversationId String       @map("conversation_id")
  senderId       String       @map("sender_id")
  body           String
  sentAt         String       @map("sent_at")
  conversacion   Conversacion @relation(fields: [conversationId], references: [id])
  @@map("mensajes_items")
}

model Transferencia {
  id           String @id
  studentId    String @map("student_id")
  fromSchoolId String @map("from_school_id")
