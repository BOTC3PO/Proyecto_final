model Modulo {
  id                   String   @id
  slug                 String?  @unique
  titulo               String
  descripcion          String?
  // FIX-MODULO-CRASH — materia. Nullable aditiva. La PERSISTENCIA
  // (POST/PUT que escriben este campo) la agrega FIX-GUARDADO; este
  // fix solo agrega la columna y la expone en el GET para que el
  // editor pueda leerla. Eventos viejos quedan con subject = null.
  subject              String?  @map("subject")
  // FIX-GUARDADO — teoría como contenido embebido (JSON serializado).
  // El front envía `theoryItems: [{ id, title, type, detail }]` y el
  // back lo persiste acá. Nullable aditiva: módulos viejos quedan con
  // theoryItems = null. No confundir con `teoriaId` (referencia a
  // TeoriaJson) que es el modelo viejo de referencias.
  theoryItems          String?  @map("theory_items")
  // FIX-MODULO-CRASH-LEVEL — nivel educativo. Nullable aditivo: módulos
  // viejos quedan con `level = null` (sin nivel persistido). El editor
  // trata `null` como string vacío. Mismo patrón que `subject` (migración
  // separada `20260617040000_modulo_level`).
  level                String?  @map("level")
  // FIX-TEST4-MOD-01 — categoría y duración en minutos. Nullable
  // aditiva: módulos viejos (beta 0.0.4 y anteriores) quedan con
  // ambos campos en `null`. El editor los muestra como "Sin
  // categoría" / "Sin duración" si están vacíos. Ver
  // `20260618000000_modulo_category_duration` para la migración.
  category             String?  @map("category")
  durationMinutes      Int?     @map("duration_minutes")
  // WO-3 — escala de notas a nivel módulo (JSON: { systemId, minPassingScore? }).
  // Nullable aditiva: módulos viejos quedan con `scoring_config = null` y el
  // cálculo de nota cae al fallback histórico (scale-0-100 + umbral). Ver
  // migración `20260620000000_modulo_scoring_config`.
  scoringConfig        String?  @map("scoring_config")
  // WO-13 — procedencia de copia. Se llena cuando este módulo es el resultado
  // de `POST /api/modulos/:id/duplicar` o del copy-on-write transparente al
  // editar uno compartido. Las 3 columnas son NULL en módulos que NO son
  // copias. `cloned_from_owner_user_id` puede ser NULL si el original era
  // huérfano. Ver migración `20260623022846_wo13_provenance`.
  clonedFromId         String?  @map("cloned_from_id")
  clonedFromTitle      String?  @map("cloned_from_title")
  clonedFromOwnerUserId String? @map("cloned_from_owner_user_id")
  visibility           String   @default("private")
  schoolId             String?  @map("school_id")
  ownerUserId          String?  @map("owner_user_id")
  teoriaId             String?  @map("teoria_id")
  tuesdayDocId         String?  @map("tuesday_doc_id")
  libroId              String?  @map("libro_id")
  defaultQuestionCount Int?     @map("default_question_count")
  dependencies         String?
  // PLAN-X §7 — "descatalogado": el profesor dueño oculta el módulo de
  // los listados generales (`GET /api/modulos`, `/buscar`) sin borrarlo.
  // Sigue visible para el dueño, para alumnos invitados
  // (`ModuloInvitacion`) y para cualquier aula donde ya esté asignado
  // (`ClaseModulo` — asignar a un aula es en sí el acto de habilitarlo).
  descatalogado        Boolean  @default(false)
  isDeleted            Boolean  @default(false) @map("is_deleted")
  createdAt            String   @default("") @map("created_at")
  updatedAt            String   @default("") @map("updated_at")
  teoria               TeoriaJson? @relation(fields: [teoriaId], references: [id])
  quizzes              Quiz[]
  @@map("modulos")
}

// "Niveles por aula con mapa de flujo" — desbloqueo manual: un docente
// puede saltear el candado por dependencias para UN alumno puntual
// (usuarioId) o para TODA un aula (aulaId) — exactamente uno de los dos
// debe estar poblado (se valida en la ruta, no acá: sqlite/postgres sin
// CHECK constraint portable en este proyecto). Gana sobre el candado por
// dependencias, no lo reemplaza — sigue existiendo aunque ya no bloquee.
model ModuloDesbloqueo {
  id          String  @id @default(uuid())
  moduloId    String  @map("modulo_id")
  usuarioId   String? @map("usuario_id")
  aulaId      String? @map("aula_id")
  otorgadoPor String  @map("otorgado_por")
  createdAt   String  @map("created_at")
  @@index([moduloId])
  @@index([usuarioId])
  @@index([aulaId])
  @@map("modulo_desbloqueos")
}

