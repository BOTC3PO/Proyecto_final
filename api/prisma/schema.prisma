}

model Quiz {
  id               String  @id
  // PLAN-CORRECCIONES C2 — nullable: un quiz "suelto" (standalone) vive
  // sin módulo hasta que el docente lo usa (clona) dentro de uno. Ver
  // migración 20260703180000_quiz_standalone.
  moduleId         String? @map("module_id")
  // Dueño del quiz mientras es standalone (moduleId null). Con módulo
  // asignado, la autorización pasa a depender del módulo (como antes)
  // y este campo queda sin usar.
  ownerUserId      String? @map("owner_user_id")
  title            String?
  isActive         Boolean @default(true) @map("is_active")
  currentVersionId String? @map("current_version_id")
  createdAt        String  @default("") @map("created_at")
  updatedAt        String  @default("") @map("updated_at")
  modulo           Modulo? @relation(fields: [moduleId], references: [id])
  versions         QuizVersion[]
  attempts         QuizAttempt[]
  @@map("quizzes")
}

model QuizVersion {
  id               String  @id
  quizId           String  @map("quiz_id")
  versionNumber    Int     @map("version_number")
  schemaVersion    Int     @default(1) @map("schema_version")
  questionSetId    String? @map("question_set_id")
  questions        String?
  generatorId      String? @map("generator_id")
  generatorVersion String? @map("generator_version")
  params           String?
  count            Int?
  seedPolicy       Int     @default(0) @map("seed_policy")
  fixedSeed        String? @map("fixed_seed")
  settings         String?
  contentHash      String? @map("content_hash")
  createdAt        String  @default("") @map("created_at")
  createdBy        String? @map("created_by")
  quiz             Quiz    @relation(fields: [quizId], references: [id])
