# ================================
# API environment variables
# Copy to api/.env and adjust values
# ================================

# Runtime
NODE_ENV=development
PORT=5050
# URL pública de ESTE server — la necesita el OAuth de MP para el redirect_uri.
API_URL=http://localhost:5050
# URL pública del front — cae acá el back_url de MercadoPago si el request
# no manda uno explícito. MP exige https (si no, su checkout puede romper
# con un CSP violation al pagar) — para eso levantar `apps/web` con HTTPS
# local (mkcert, ver apps/web/vite.config.ts) y usar https:// acá.
APP_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173,http://localhost:8081
# ^ 8081 es el puerto default de `expo start --web` (apps/mobile) —
# sólo hace falta para probar la app móvil vía navegador; el target real
# (Android/iOS) no pasa por CORS. Ver apps/mobile/README.md.

# Database (PostgreSQL — principal)
DATABASE_URL="postgresql://user:password@localhost:5432/virtualbook"

# Storage de media (uploads de /api/media: imagen/audio/video/PDF de los
# bloques). "local" = disco (default, sólo válido corriendo 1 instancia
# del API). "s3" = cualquier endpoint S3-compatible (AWS S3, Cloudflare
# R2, Backblaze B2, MinIO) — necesario para escalar a 2+ instancias.
MEDIA_STORAGE=local
MEDIA_S3_BUCKET=
MEDIA_S3_ENDPOINT=
MEDIA_S3_REGION=auto
MEDIA_S3_ACCESS_KEY_ID=
MEDIA_S3_SECRET_ACCESS_KEY=
# Opcional: dominio/CDN público del bucket. Si se define, GET /api/media/:x
# redirige ahí en vez de proxyear el archivo por el API.
MEDIA_S3_PUBLIC_URL=

# Redis para rate limiting distribuido (opcional). Vacío = MemoryStore por
# proceso, correcto con 1 sola instancia del API. Necesario para que el
# límite sea preciso corriendo 2+ instancias.
REDIS_URL=

# SQLite legacy paths (core ya no se usa; solo para referencia de migración)
SQLITE_CORE_PATH=./src/base/core_schema.sqlite
SQLITE_CONTENT_PATH=./src/base/modulos_quizzes.sqlite

# SQLite diccionario (servicio /api/dictionary)
SQLITE_PATH=./src/diccionarios/Diccionario.sqlite
SQLITE_READONLY=true
SQLITE_CACHE_KB=65536

# Maps/content SQLite (for /api/maps) — NOTA: pese al nombre del archivo,
# esto es el cache de manifest de TopoJSON (tabla `map_assets`), no la
# búsqueda de lugares (ver GEONAMES_SQLITE_PATH más abajo). Coincidencia
# de nombre de archivo, no la misma feature.
CONTENT_SQLITE_PATH=./src/maps/geonames_index.sqlite

# GeoNames SQLite (para /api/maps/geonames/buscar — "Buscar lugar" del
# editor de mapas: países/ciudades + nombres alternativos por idioma).
GEONAMES_SQLITE_PATH=./src/maps/geonames_index.sqlite

# MongoDB (solo para migracion con migrate_mongo_to_sqlite.ts; no requerido en produccion)
# MONGO_URI=mongodb://localhost:27017
# DB_NAME=educational_platform
# MONGO_TLS=false
# MONGO_REQUIRE_TLS=true
# MONGO_CA_FILE=
# MONGO_CERT_FILE=
# MONGO_APP_NAME=educational-platform-api
# MONGO_MAX_POOL_SIZE=10
# MONGO_MIN_POOL_SIZE=0
# MONGO_SERVER_SELECTION_MS=5000
# MONGO_REQUIRE_AUTH=true

# Auth and bootstrap (set secure values in non-dev environments)
JWT_SECRET=dev-secret
JWT_REFRESH_SECRET=
JWT_ISSUER=
JWT_AUDIENCE=
JWT_ACCESS_TTL_SECONDS=3600
# QA-FIX-11: refresh token TTL. Con 0 (default previo) el servicio NUNCA emitía
# refresh tokens, así que a la 1h el access vencía y el front expulsaba al usuario.
# 604800 = 7 días. Ver docs/qa/qa-fix-11.md.
JWT_REFRESH_TTL_SECONDS=604800
BOOTSTRAP_ADMIN_KEY=

# Request and security controls
MAX_PAGE_MB=30
AUTH_RATE_LIMIT_DISABLED=false
ENABLE_SEED_ENDPOINT=false

# Payments
PAYMENTS_WEBHOOK_SECRET=

# PLAN-B — pasarelas de cobro escuela→familias (api/src/lib/pasarelas/).
# Credenciales de PLATAFORMA de VB (sacadas de developers.mercadopago.com,
# app propia, credenciales de PRUEBA para probar en sandbox). Las de cada
# escuela (cuentaConectadaId del vendedor de prueba) se cargan desde la UI
# (Cobros de la escuela → Pasarelas), no acá.
#
# OJO: apenas cargás CUALQUIERA de estas credenciales, el server exige al
# arrancar MP_WEBHOOK_SECRET y PASARELAS_ENCRYPTION_KEY (ver
# assertSecretosDePago en lib/env.ts) y se niega a levantar si faltan. Es a
# propósito: sin esos dos, los webhooks se aceptan sin firma y los tokens de
# las escuelas quedan cifrados con una clave pública.
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=
# Obligatorio si hay credenciales de MP. Sin él, verificarWebhookMP rechaza
# todo (antes aceptaba cualquier webhook fuera de NODE_ENV=production).
MP_WEBHOOK_SECRET=
# OAuth de MP (lib/mercadopago-oauth.ts) — sin esto, la escuela no puede
# autorizar a VB como marketplace y MercadoPagoProvider.createCheckout
# rechaza el checkout (confirmado contra la API real: "collector_id
# invalid"). MP_CLIENT_ID es el "número de aplicación" — visible en
# Credenciales de PRUEBA (developers.mercadopago.com → tu app). Pero
# MP_CLIENT_SECRET sólo aparece en Credenciales de PRODUCCIÓN, activadas
# (requiere completar datos del negocio) — no hay forma de conseguirlo
# en modo test únicamente.
MP_CLIENT_ID=
MP_CLIENT_SECRET=
CRYPTOMUS_MERCHANT_ID=
CRYPTOMUS_API_KEY=
# Clave simétrica para cifrar EscuelaPasarela.credencialesCifradas (32 bytes,
# base64 o hex). Obligatoria si hay cualquier pasarela configurada — sin ella
# se usaría una clave fija y pública. Generar con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PASARELAS_ENCRYPTION_KEY=
# Escape hatch SOLO para desarrollo local: permite arrancar con pasarelas
# configuradas pero sin los dos secretos de arriba. Avisa por consola y es
# ignorado si NODE_ENV=production.
PAGOS_DEV_SIN_SECRETOS=false

# Billing/governance knobs
BILLING_PAST_DUE_DAYS=7
BILLING_SUSPEND_DAYS=30
BILLING_DELINQUENCY_JOB_INTERVAL_MINUTES=60
BILLING_DELINQUENCY_JOB_ENABLED=true

# Optional script defaults
AUTH_HEALTH_EMAIL=admin@escuela.com
ADMIN_USERNAME=admin.escuela
