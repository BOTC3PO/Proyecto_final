{
  "name": "api",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "nodemon",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:init": "ts-node --transpile-only scripts/init_db.ts",
    "db:seed": "ts-node --transpile-only scripts/seed_demo.ts",
    "validate:economia": "node scripts/validarEconomia.js",
    "dict:smoke": "ts-node --transpile-only scripts/dict_smoke_test.ts",
    "dict:explain": "ts-node --transpile-only scripts/explain_plan.ts",
    "admin:ensure-runtime": "ts-node --transpile-only scripts/ensure_admin_runtime.ts",
    "auth:health": "ts-node --transpile-only scripts/auth_health_check.ts",
    "maps:index": "ts-node --transpile-only scripts/index_maps_to_sqlite.ts",
    "db:inventory": "ts-node --transpile-only scripts/analyze-db-usage.ts",
    "seed:demo": "ts-node --transpile-only scripts/seed_demo.ts",
    "sync:generadores": "ts-node --transpile-only scripts/sync-generator-subtipos.ts"
  },
  "prisma": {
    "seed": "ts-node --transpile-only prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.7.0",
    "@prisma/client": "7.7.0",
    "better-sqlite3": "12.6.2",
    "compression": "1.8.1",
    "cors": "2.8.5",
    "dotenv": "17.2.3",
    "express": "5.2.1",
    "express-rate-limit": "7.5.0",
    "helmet": "8.1.0",
    "morgan": "1.10.1",
    "pg": "^8.20.0",
    "prisma": "7.7.0",
    "zod": "4.3.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13",
    "@types/compression": "^1.8.1",
    "@types/express": "5.0.6",
    "@types/morgan": "1.9.10",
    "@types/node": "^25.6.0",
    "@types/pg": "^8.20.0",
    "nodemon": "3.1.11",
    "ts-node": "10.9.2",
    "typescript": "5.9.3"
  }
}
