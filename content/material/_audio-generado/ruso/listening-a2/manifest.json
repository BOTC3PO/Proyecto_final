 },
 {
  "n": 2,
  "file": "q02.mp3",
  "text": "Меня зовут Мария, я из Испании.",
  "spoken": "Меня зовут Мария, я из Испании.",
  "voice": "ru_RU-denis-medium",
  "seconds": 2.5
 },
 {
  "n": 3,
  "file": "q03.mp3",
  "text": "Мне двадцать лет.",
